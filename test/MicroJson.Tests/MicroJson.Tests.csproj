<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <SonarQubeExclude>true</SonarQubeExclude>
    <LangVersion>preview</LangVersion>
    <CoverletOutputFormat>opencover</CoverletOutputFormat>
    <CoverletOutput>../../coverage.xml</CoverletOutput>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="10.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>
  <ItemGroup>
    <None Update="JSONTestSuite/**" CopyToOutputDirectory="PreserveNewest" />
    <!-- input for the generator driver tests -->
    <None Include="SerializationTests.cs" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MicroJson\MicroJson.csproj" />
    <!-- used both as analyzer (end-to-end tests) and as library (generator driver tests) -->
    <ProjectReference Include="..\..\src\MicroJson.SourceGenerator\MicroJson.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
  </ItemGroup>
</Project>
