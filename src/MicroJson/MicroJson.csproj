<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>A minimal JSON library for .NET optimized for Native AOT and small binary size.</Description>
    <Copyright>Copyright 2011-$([System.DateTime]::Now.Year) Michael Ganss</Copyright>
    <AssemblyTitle>MicroJson</AssemblyTitle>
    <CI_Build_Version Condition="'$(CI_BUILD_VERSION)' == ''">1.0.0</CI_Build_Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <InformationalVersion>$(CI_Build_Version)</InformationalVersion>
    <FileVersion>$(CI_Build_Version).0</FileVersion>
    <PackageVersion>$(CI_Build_Version)</PackageVersion>
    <Authors>Michael Ganss</Authors>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MicroJson</AssemblyName>
    <AssemblyOriginatorKeyFile>MicroJson.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <PackageId>MicroJson</PackageId>
    <PackageTags>json;parser;serializer;aot;nativeaot;trimming</PackageTags>
    <PackageProjectUrl>https://github.com/mganss/MicroJson</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>git://github.com/mganss/MicroJson</RepositoryUrl>
    <RootNamespace>MicroJson</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'True'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
