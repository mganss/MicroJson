<Project Sdk="Microsoft.NET.Sdk">
  <!-- equivalent to a PackageReference to MicroJson: the library plus its source generator -->
  <ItemGroup>
    <ProjectReference Include="../../../src/MicroJson/MicroJson.csproj" />
    <ProjectReference Include="../../../src/MicroJson.SourceGenerator/MicroJson.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- JsonParser returns double instead of decimal; Trim="true" lets the AOT compiler remove the decimal code -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="MicroJson.UseDecimal" Value="false" Trim="true" />
  </ItemGroup>
</Project>
